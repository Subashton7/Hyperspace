{
  "name": "hyperspace",
  "productName": "HYPERSPACE",
  "version": "0.14.0",
  "description": "HYPERSPACE: a Matrix-styled control deck for Windows: mic and camera kill switches, task manager, temperatures and fans, VJ visualizer, music crate, encrypted notes, phone remote.",
  "author": {
    "name": "HYPERSPACE"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "core": "node scripts/build-core.js",
    "icon": "electron scripts/make-icon.js",
    "package": "node scripts/package.js",
    "installer": "node scripts/build-core.js x64 && electron-builder --win nsis zip --x64",
    "core:x64": "node scripts/build-core.js x64",
    "dist": "node scripts/build-core.js x64 arm64 && electron-builder --win nsis zip --x64 --arm64 --publish never"
  },
  "homepage": "https://github.com/Subashton7/Hyperspace",
  "repository": { "type": "git", "url": "https://github.com/Subashton7/Hyperspace.git" },
  "license": "MIT",
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "electron-updater": "^6.8.11",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.33.16"
  },
  "build": {
    "appId": "com.hyperspace.systemshaman",
    "productName": "HYPERSPACE",
    "copyright": "HYPERSPACE",
    "publish": [{ "provider": "github", "owner": "Subashton7", "repo": "Hyperspace", "releaseType": "release" }],
    "directories": {
      "output": "installer"
    },
    "files": [
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "src/hw.ps1",
      "src/onenote.ps1"
    ],
    "extraResources": [
      {
        "from": "core/dist/${arch}/HyperCore.exe",
        "to": "HyperCore.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "HYPERSPACE-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HYPERSPACE",
      "runAfterFinish": true,
      "artifactName": "HYPERSPACE-Setup-${version}-${arch}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
